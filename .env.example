# 复制为 .env 后填写真实值。`.env` 已被 .gitignore 排除，不要提交。

# 必填：PowerContext 服务地址，不带末尾斜杠。
POWERCONTEXT_URL=http://127.0.0.1:8787

# 必填：写入文档记忆时使用的 scope_id（每个知识库/租户一个）。
POWERCONTEXT_SCOPE=docmind

# 可选：存放用户偏好的 scope_id。留空则服务启动时自动创建
# （POST /v1/scopes，幂等键 docmind-pref-scope-v1，重复启动复用同一个）。
# POWERCONTEXT_MEMORY_SCOPE=

# 若你的 PowerContext 需要鉴权，在此补充 token，不要写进代码：
# POWERCONTEXT_TOKEN=

# 可选：scripts/run.sh 使用，缺省为 127.0.0.1:8000
DOCMIND_HOST=127.0.0.1
DOCMIND_PORT=8000
